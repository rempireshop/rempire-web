{
  "name": "rempire-web",
  "version": "0.1.0",
  "private": true,
  "description": "REMPIRE shop rebuild — storefront + admin (Next.js). First route: /qa questionnaire for Renat.",
  "scripts": {
    "dev": "next dev --port 3300",
    "prebuild": "node tools/pack-migrations.mjs && node tools/pack-content.mjs && node tools/prerender-shop2.mjs",
    "build": "next build",
    "postbuild": "node tools/migrate.mjs --if-configured",
    "start": "next start --port 3300",
    "prerender": "node tools/prerender-shop2.mjs",
    "prerender:check": "node tools/check-prerender.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "node tools/migrate.mjs",
    "build:variants": "node tools/build-catalogue-variants.mjs",
    "build:bundles": "node tools/build-bundles.mjs",
    "test": "vitest run",
    "i18n:gaps": "node tools/i18n-gaps.mjs",
    "pack:migrations": "node tools/pack-migrations.mjs",
    "pack:content": "node tools/pack-content.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "@vercel/blob": "^2.8.0",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
