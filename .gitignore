.next/
out/
next-env.d.ts

# build info
*.tsbuildinfo

# vercel
.vercel/

# misc
.DS_Store
*.log

.vercel
.env*

# generated at build by tools/prerender-shop2.mjs (npm run prerender / prebuild)
public/shop2/p/
public/shop2/c/
public/shop2/b/
public/shop2/info/
public/shop2/set/
public/shop2/sets/
public/shop2/gift/
public/shop2/brands/
public/shop2/et/
public/shop2/en/
# public/shop/og/*.jpg and public/brand/og-default.png are generated by the
# same tool but are NOT ignored: they are drawn once from images that are in
# the repo, and committing them keeps them out of every future build. Delete
# one and the next `npm run prerender` draws it again.

# generated at build by tools/copy-vendor.mjs (prebuild) from node_modules/leaflet
public/vendor/leaflet/

# Playwright (docs/testing.md) — run artifacts only. e2e/__screenshots__/ is
# NOT ignored: those .png files are the committed visual-regression baselines.
/playwright-report/
/test-results/
/blob-report/

# sitemap.xml (the index), its sitemap-N.xml chunks and the three robots files
# are written by tools/prerender-shop2.mjs on every build (Vercel prebuild) and
# by tools/e2e-build.mjs with the e2e server's localhost base URL — generated
# output, never hand-edited. sitemap-custom.xml is not a file: the app serves
# it (src/app/sitemap-custom.xml/route.ts).
public/sitemap.xml
public/sitemap-*.xml
public/robots.txt
public/robots.production.txt
public/robots.staging.txt
