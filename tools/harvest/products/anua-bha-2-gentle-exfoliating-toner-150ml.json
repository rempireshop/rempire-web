{"product":{"id":9746193940819,"title":"Anua - BHA 2% Gentle Exfoliating Toner 150ml","body_html":"\u003cdiv class=\"flex max-w-full flex-col flex-grow\"\u003e\n\u003cdiv data-message-author-role=\"assistant\" data-message-id=\"0c358100-6554-4e81-986e-7b3e2245134f\" dir=\"auto\" class=\"min-h-8 text-message flex w-full flex-col items-end gap-2 whitespace-normal break-words text-start [.text-message+\u0026amp;]:mt-5\" data-message-model-slug=\"gpt-4o\"\u003e\n\u003cdiv class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\"\u003e\n\u003cdiv class=\"markdown prose w-full break-words dark:prose-invert dark\"\u003e\n\u003cp\u003e\u003cstrong\u003eAnua BHA 2% Gentle Exfoliating Toner 150ml – Clearer, Smoother Skin Starts Here\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eAchieve a fresh, refined complexion with \u003cstrong\u003eAnua BHA 2% Gentle Exfoliating Toner\u003c\/strong\u003e, a lightweight yet powerful formula designed to unclog pores, control oil, and smooth skin texture. Infused with \u003cstrong\u003e2% salicylic acid\u003c\/strong\u003e, this toner gently exfoliates to reduce breakouts and congestion while \u003cstrong\u003etea tree extract\u003c\/strong\u003e calms irritation and redness.\u003c\/p\u003e\n\u003ch3\u003e\u003cstrong\u003eWhy You'll Love It:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cp\u003e\u003cstrong\u003eDeep Pore Cleansing:\u003c\/strong\u003e BHA removes excess oil and dead skin cells, preventing breakouts.\u003cbr\u003e\u003cstrong\u003eSoothing \u0026amp; Hydrating:\u003c\/strong\u003e Tea tree extract calms inflammation, while six ceramides strengthen the skin barrier.\u003cbr\u003e\u003cstrong\u003eLightweight \u0026amp; Non-Irritating:\u003c\/strong\u003e Absorbs quickly, leaving skin refreshed without stripping moisture.\u003c\/p\u003e\n\u003ch3\u003e\u003cstrong\u003ePerfect for Acne-Prone \u0026amp; Oily Skin\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cp\u003eFragrance-free and dermatologist-tested, this \u003cstrong\u003egentle yet effective exfoliating toner\u003c\/strong\u003e helps you achieve balanced, healthy-looking skin. Use it daily for a visibly smoother, more refined glow\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e","vendor":"Rempire Tower Shop","product_type":"Toner","created_at":"2025-02-04T22:30:43+02:00","handle":"anua-bha-2-gentle-exfoliating-toner-150ml","updated_at":"2026-09-02T13:03:25+03:00","published_at":"2025-02-04T22:30:43+02:00","template_suffix":"","published_scope":"web","tags":"aha, ANUA, cleanser, korean, TONER","variants":[{"id":50333015277907,"product_id":9746193940819,"title":"Default Title","price":"21.39","sku":"","position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":"shopify","option1":"Default Title","option2":null,"option3":null,"created_at":"2025-02-04T22:30:44+02:00","updated_at":"2026-09-02T13:03:25+03:00","taxable":true,"barcode":"NA","grams":0,"image_id":null,"weight":0.0,"weight_unit":"kg","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"EUR","compare_at_price_currency":"","quantity_price_breaks":[]}],"options":[{"id":12297416343891,"product_id":9746193940819,"name":"Title","position":1,"values":["Default Title"]}],"images":[{"id":61261839892819,"product_id":9746193940819,"position":1,"created_at":"2025-02-04T22:29:55+02:00","updated_at":"2025-02-04T22:29:56+02:00","alt":null,"width":680,"height":840,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0607\/8555\/7760\/files\/anua-bha-2-gentle-exfoliating-toner.png?v=1738700996","variant_ids":[]}],"image":{"id":61261839892819,"product_id":9746193940819,"position":1,"created_at":"2025-02-04T22:29:55+02:00","updated_at":"2025-02-04T22:29:56+02:00","alt":null,"width":680,"height":840,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0607\/8555\/7760\/files\/anua-bha-2-gentle-exfoliating-toner.png?v=1738700996","variant_ids":[]}}}